rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function id(value) {
      return value is string && value.size() > 0 && value.size() <= 1500
        && !value.matches('.*[/].*') && value != '.' && value != '..' && !value.matches('__.*__');
    }
    function dateKey(value) {
      // Calendar shape/range check; the client additionally checks month lengths.
      return value is string && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function nonnegative(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function base(d, uid, fields) {
      let keys = fields.concat(['schemaVersion', 'ownerId']);
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys) && d.schemaVersion == 1
        && d.schemaVersion is int && d.ownerId == uid;
    }
    function task(d, uid, taskId) {
      return base(d, uid, ['id', 'text', 'completed', 'order']) && d.id == taskId
        && id(taskId) && text(d.text, 10000) && d.completed is bool && nonnegative(d.order);
    }
    // Every aggregate mutation participates in one owner-scoped membership CAS.
    // Cacheable get/getAfter calls keep large snapshots within rule access limits.
    function lifecycleChanged(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/lifecycle/state;
      return getAfter(p).data.revision == get(p).data.revision + 1;
    }
    function parentPresent(uid, parent) {
      return parent in getAfter(/databases/$(database)/documents/users/$(uid)/lifecycle/state).data.parents;
    }
    function member(uid, parent, taskId) {
      return parentPresent(uid, parent)
        && getAfter(/databases/$(database)/documents/users/$(uid)/lifecycle/state).data.parents[parent].hasAny([taskId]);
    }
    function orderedMember(uid, parent, d) {
      let ids = getAfter(/databases/$(database)/documents/users/$(uid)/lifecycle/state).data.parents[parent];
      return d.order < ids.size() && ids[d.order] == d.id;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && base(request.resource.data, uid, []);
      allow update: if owner(uid) && resource.data.ownerId == uid && base(request.resource.data, uid, []);
      allow delete: if owner(uid);

      match /lifecycle/{stateId} {
        function valid(d) {
          return stateId == 'state' && base(d, uid, ['revision', 'parents'])
            && nonnegative(d.revision) && d.parents is map && d.parents.size() <= 349;
        }
        allow read: if owner(uid) && stateId == 'state';
        allow create: if owner(uid) && valid(request.resource.data)
          && request.resource.data.revision == 0 && request.resource.data.parents.size() == 0;
        allow update: if owner(uid) && valid(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /days/{dayId} {
        function valid(d) {
          return base(d, uid, ['dateKey', 'currentListId']) && dateKey(dayId) && d.dateKey == dayId
            && (d.currentListId == null || id(d.currentListId));
        }
        allow read: if owner(uid);
        allow delete: if owner(uid) && lifecycleChanged(uid) && !parentPresent(uid, 'days/' + dayId);
        allow create: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'days/' + dayId) && valid(request.resource.data);
        allow update: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'days/' + dayId) && resource.data.ownerId == uid && valid(request.resource.data);
        match /tasks/{taskId} {
          allow read: if owner(uid);
          allow delete: if owner(uid) && lifecycleChanged(uid) && !member(uid, 'days/' + dayId, taskId);
          allow create, update: if owner(uid) && lifecycleChanged(uid) && member(uid, 'days/' + dayId, taskId)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/days/$(dayId))
            && dateKey(dayId) && task(request.resource.data, uid, taskId)
            && orderedMember(uid, 'days/' + dayId, request.resource.data);
        }
      }
      match /savedLists/{listId} {
        function valid(d) {
          return base(d, uid, ['id', 'name', 'createdAt', 'updatedAt', 'order']) && d.id == listId && id(listId)
            && text(d.name, 200) && text(d.createdAt, 64) && text(d.updatedAt, 64) && nonnegative(d.order);
        }
        allow read: if owner(uid);
        allow delete: if owner(uid) && lifecycleChanged(uid) && !parentPresent(uid, 'savedLists/' + listId);
        allow create: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'savedLists/' + listId) && valid(request.resource.data);
        allow update: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'savedLists/' + listId) && resource.data.ownerId == uid && valid(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        match /tasks/{taskId} {
          allow read: if owner(uid);
          allow delete: if owner(uid) && lifecycleChanged(uid) && !member(uid, 'savedLists/' + listId, taskId);
          allow create, update: if owner(uid) && lifecycleChanged(uid) && member(uid, 'savedLists/' + listId, taskId)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/savedLists/$(listId))
            && id(listId) && task(request.resource.data, uid, taskId)
            && orderedMember(uid, 'savedLists/' + listId, request.resource.data);
        }
      }
      match /finishedDays/{finishedId} {
        function valid(d) {
          return base(d, uid, ['id', 'dateKey', 'date', 'createdAt', 'completedCount', 'totalCount', 'order'])
            && d.id == finishedId && id(finishedId) && dateKey(d.dateKey) && text(d.date, 64) && text(d.createdAt, 64)
            && nonnegative(d.completedCount) && nonnegative(d.totalCount) && d.completedCount <= d.totalCount && nonnegative(d.order);
        }
        allow read: if owner(uid);
        allow delete: if owner(uid) && lifecycleChanged(uid) && !parentPresent(uid, 'finishedDays/' + finishedId);
        allow create: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'finishedDays/' + finishedId) && valid(request.resource.data);
        allow update: if owner(uid) && lifecycleChanged(uid) && parentPresent(uid, 'finishedDays/' + finishedId) && resource.data.ownerId == uid && valid(request.resource.data)
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.date == resource.data.date && request.resource.data.createdAt == resource.data.createdAt;
        match /tasks/{taskId} {
          allow read: if owner(uid);
          allow delete: if owner(uid) && lifecycleChanged(uid) && !member(uid, 'finishedDays/' + finishedId, taskId);
          allow create, update: if owner(uid) && lifecycleChanged(uid) && member(uid, 'finishedDays/' + finishedId, taskId)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/finishedDays/$(finishedId))
            && id(finishedId) && task(request.resource.data, uid, taskId)
            && orderedMember(uid, 'finishedDays/' + finishedId, request.resource.data);
        }
      }
      match /preferences/{preferenceId} {
        function valid(d) {
          return preferenceId == 'general' && base(d, uid, ['themeId'])
            && d.themeId in ['plum', 'forest', 'ocean', 'rose', 'midnight'];
        }
        allow read: if owner(uid);
        allow delete: if owner(uid) && preferenceId == 'general';
        allow create: if owner(uid) && valid(request.resource.data);
        allow update: if owner(uid) && resource.data.ownerId == uid && valid(request.resource.data);
      }
      match /imports/{importId} {
        function valid(d) {
          return base(d, uid, ['id', 'sourceId', 'backupHash', 'status', 'createdAt', 'completedAt'])
            && d.id == importId && id(importId) && id(d.sourceId) && d.backupHash is string
            && d.backupHash.matches('[a-f0-9]{64}') && text(d.createdAt, 64)
            && ((d.status == 'pending' && d.completedAt == null) || (d.status == 'complete' && text(d.completedAt, 64)));
        }
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && valid(request.resource.data);
        allow update: if owner(uid) && resource.data.ownerId == uid && valid(request.resource.data)
          && request.resource.data.sourceId == resource.data.sourceId && request.resource.data.backupHash == resource.data.backupHash
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.status != 'complete' || request.resource.data.status == 'complete');
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
