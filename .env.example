# Firebase Console > Project settings > General > Your apps > Web app config.
# Client Web app settings only. Never use service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Normal development is guest-only. To deliberately use production Auth locally,
# set BOTH values below. No flag enables Firestore or synchronization.
# VITE_FIREBASE_ENV=production
# VITE_ALLOW_PRODUCTION_AUTH=true
# Builds in production/github preserve optional production Auth without these flags.
# Dormant read-only staging uses a separate TASKLY_STAGING_* contract.
# See docs/firebase-spark-staging.md; do not put staging settings here.
# No staging mode/build or live connection is enabled.
