{
  "name": "taskly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:rules": "node --test tests/emulator/firestore.rules.mjs",
    "dev": "vite",
    "dev:cloud-test": "vite --mode cloud-test",
    "emulators:cloud-test": "firebase emulators:start --config firebase.isolated.json --only auth,firestore --project demo-taskly-isolated",
    "test:cloud-ui": "firebase emulators:exec --config firebase.isolated.json --only auth,firestore --project demo-taskly-isolated \"node scripts/cloud-ui.mjs\"",
    "build": "vite build",
    "deploy:firebase": "node scripts/firebase-deploy.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide": "^1.40.0",
    "sortablejs": "^1.15.7"
  }
}
