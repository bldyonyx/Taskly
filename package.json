{
  "name": "taskly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:https": "node --test tests/staging-https.test.js tests/staging-client.test.js",
    "test:rules": "node --test tests/emulator/firestore.rules.mjs",
    "test:trusted": "firebase emulators:exec --config firebase.trusted.local.json --only auth,firestore --project demo-taskly-trusted \"node --test tests/emulator/trusted.mjs\"",
    "emulators:trusted": "firebase emulators:start --config firebase.trusted.local.json --only auth,firestore --project demo-taskly-trusted",
    "dev:trusted": "node tools/trusted/server.mjs",
    "dev": "vite",
    "dev:cloud-test": "vite --mode cloud-test",
    "emulators:cloud-test": "firebase emulators:start --config firebase.trusted.local.json --only auth,firestore --project demo-taskly-trusted",
    "test:cloud-ui": "firebase emulators:exec --config firebase.trusted.local.json --only auth,firestore --project demo-taskly-trusted \"node scripts/cloud-ui.mjs\"",
    "build": "vite build",
    "deploy:firebase": "node scripts/firebase-deploy.mjs",
    "preview": "vite preview",
    "fixture:trusted": "node tools/trusted/fixture.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide": "^1.40.0",
    "sortablejs": "^1.15.7"
  }
}
